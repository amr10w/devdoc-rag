# DevDoc RAG Configuration Template

# API & Frontend Configuration
API_BASE_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0

# Ollama LLM Configuration (Remote Cloud or Local)
# Remote Cloud Endpoint:
OLLAMA_API_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=glm-5.2:cloud

# Local Endpoint alternative:
# OLLAMA_API_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:latest
# OLLAMA_EMBED_MODEL=qwen3-embedding:latest

# Embedding Provider (onnx or ollama)
EMBEDDING_PROVIDER=onnx
VECTOR_DIMENSION=384

# Retrieval Strategy (vector, hybrid_rrf, or text)
RETRIEVAL_METHOD=vector

# Qdrant Vector Database (Cloud or Local Embedded)
QDRANT_API_URL=https://5e7cb32d-0fbe-4697-ac58-64ef2cc7ada5.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_STORAGE_PATH=src/data/qdrant_storage

# Telemetry Database
RAG_LOGS_DB=src/data/rag_logs.db
